# Local PostgreSQL (use docker compose up -d db). In Neon, DATABASE_URL must be
# the pooled URL and DIRECT_URL must be the non-pooler URL from Connection Details.
DATABASE_URL="postgresql://rentalverify:rentalverify@localhost:5432/rentalverify?schema=public"
DIRECT_URL="postgresql://rentalverify:rentalverify@localhost:5432/rentalverify?schema=public&connection_limit=1"
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_MODE="true"
# Optional shared serverless rate limiting. Configure either the UPSTASH_* pair
# or the Vercel KV_REST_* pair; leave both pairs unset for local-only limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Optional providers; never required for a production build and server-side only
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_PROVIDER="demo"
STRIPE_SECRET_KEY=""
STRIPE_MODE="test"
STRIPE_LIVE_MODE_ACKNOWLEDGED="false"
STRIPE_WEBHOOK_SECRET=""
STRIPE_REPORT_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
# Optional account email delivery. Resend on Vercel needs these two values.
RESEND_API_KEY=""
EMAIL_FROM=""
# Optional generic HTTP provider fallback. Leave these unset when using Resend.
EMAIL_PROVIDER=""
EMAIL_API_URL=""
EMAIL_API_KEY=""
PROPERTY_PROVIDER="demo"
RENTCAST_API_KEY=""
REVERSE_IMAGE_API_KEY=""
# OCR/reverse-image adapters (server-side only; never prefix keys with NEXT_PUBLIC_)
OCR_PROVIDER=""
OCR_API_URL=""
OCR_API_KEY=""
REVERSE_IMAGE_PROVIDER=""
REVERSE_IMAGE_API_URL=""
IMAGE_PROVIDER_TIMEOUT_MS="5000"
